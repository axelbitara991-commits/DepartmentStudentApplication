<%= form_with(model: section) do |form| %>
  <% if section.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(section.errors.count, "error") %> prohibited this section from being saved:</h2>

      <ul>
        <% section.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, style: "display: block" %>
    <%= form.text_field :name %>
  </div>

  <div>
    <%= form.label :timeslot, style: "display: block" %>
    <%= form.text_field :timeslot %>
  </div>

  <div>
    <%= form.submit %>
  </div>

  <div>
    <%= form.label :subject_id, "Subject" %>
    <%= form.collection_select :subject_id, Subject.all, :id, :name,
        { prompt: "Select a Subject" } %>
  </div>
  <div>
    <%= form.label :student_id, "Student" %>
    <%= form.collection_select :student_id, Student.all, :id, :name,
        { prompt: "Select a Student" } %>
  </div>

  <div>
    <%= form.label :section_id, "Section" %>
    <%= form.collection_select :section_id, Section.all, :id, :name,
        { prompt: "Select a Section" } %>
  </div>
    <div>
    <%= form.label :room, "Room" %>
    <%= form.text_field :room %>
  </div>
<% end %>
